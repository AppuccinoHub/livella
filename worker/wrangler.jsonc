{
  // Settings Cloudflare reads when it builds the Worker from this folder.
  // Secrets (ANTHROPIC_API_KEY, PASSCODE) are NOT here; they are added in the Cloudflare dashboard.
  "name": "livella-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Storage for shared lessons. No id is given on purpose: Cloudflare creates it on the first deploy.
  "kv_namespaces": [
    { "binding": "LESSONS" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://appuccinohub.github.io"
  }
}
